    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.32.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3"
  }
}
