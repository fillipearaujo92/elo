{
  "name": "@sysled/wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway WhatsApp proprio do Sysled Chat, wire-compativel com a API do WAHA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
