{
  "name": "elo-gateway",
  "version": "0.9.0",
  "private": true,
  "description": "ELO — gateway WhatsApp self-hosted. Instale no seu servidor e integre no seu sistema de atendimento.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "npm run build && node tests/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@hapi/boom": "^10.0.1",
    "baileys": "7.0.0-rc14",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fillipearaujo92/elo.git"
  },
  "overrides": {
    "ajv": {
      "fast-uri": "^3.1.5"
    },
    "fast-json-stringify": {
      "fast-uri": "^4.1.2"
    }
  }
}
